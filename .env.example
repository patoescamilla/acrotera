# ---------- Supabase ----------
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clave de servicio. NUNCA la expongas en el navegador ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- Stripe ----------
# Empieza siempre con las llaves de prueba (sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# La entrega `stripe listen` o el dashboard te dan este secreto
STRIPE_WEBHOOK_SECRET=whsec_...
# Cobro en efectivo en OXXO. Requiere activarlo en el dashboard de Stripe.
STRIPE_ENABLE_OXXO=false

# ---------- Tienda ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# El costo de envío y el monto de envío gratis ya NO viven aquí:
# se configuran desde el panel, en Textos -> Envío.
